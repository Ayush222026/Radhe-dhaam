name: Update pravachan videos
on:
  schedule:
    - cron: "30 0 * * *"
  workflow_dispatch:
permissions:
  contents: write
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: python update.py
      - run: |
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add videos.json
          git diff --cached --quiet || (git commit -m "update videos" && git push)
